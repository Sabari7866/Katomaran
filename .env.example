# ============================================
# Katomaran URL Shortener - Environment Variables
# ============================================
# Copy this file to set up .env in each directory.
# See individual .env.example files in each subdirectory.

# --- Backend (urlshortener-backend/.env) ---
# PORT=5000
# MONGODB_URI=mongodb://localhost:27017/urlshortener
# JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# FRONTEND_URL=http://localhost:3000

# --- Frontend (urlshortener-frontend/.env) ---
# REACT_APP_API_URL=http://localhost:5000/api
# REACT_APP_BACKEND_URL=http://localhost:5000
# BROWSER=none
